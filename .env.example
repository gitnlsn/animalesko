# -----------------------------------------------------------------------------
# Copy to .env and adjust. `pnpm db:up` provisions a Postgres matching these.
# -----------------------------------------------------------------------------

# Postgres provisioned by docker-compose.yml
POSTGRES_USER=animalesko
POSTGRES_PASSWORD=animalesko
POSTGRES_PORT=5433

# Application database
DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_dev?schema=public"

# Unpooled connection, used by `prisma migrate`. Identical locally; on Vercel this
# is the direct (non-pgbouncer) URL while DATABASE_URL points at the pooler.
DIRECT_DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_dev?schema=public"

# Database used by the integration suite. Wiped and re-migrated on every run —
# never point this at anything you care about.
TEST_DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_test?schema=public"

# -----------------------------------------------------------------------------
# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET="dev-only-secret-change-me-before-deploying"
BETTER_AUTH_URL="http://localhost:3000"

# Extra origins allowed to post to /api/auth, comma-separated. The app's own URL
# and the Vercel-provided hostnames are trusted automatically; a custom domain
# is not reported by anything at runtime, so it has to be listed here or sign-in
# from it is rejected as cross-site with INVALID_ORIGIN.
AUTH_TRUSTED_ORIGINS=""

# Cookies are shared across both apps in production so a single session works on
# app.animalesko.org and plus.animalesko.org. Leave empty for localhost.
AUTH_COOKIE_DOMAIN=""

# -----------------------------------------------------------------------------
# Public URLs — apps/app runs on 3000, apps/plus on 3001, apps/landing on 3003
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PLUS_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# apps/landing — the public marketing site
# -----------------------------------------------------------------------------
# The canonical origin of the landing. Every canonical tag, the sitemap and the
# Open Graph URLs are built from it, so a wrong value here points search engines
# at the wrong host. On Vercel it can be left empty: the production domain is
# read from VERCEL_PROJECT_PRODUCTION_URL, which is what preview builds need in
# order to canonicalise to production rather than to their own throwaway URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3003"

# Where the "sou prestador" buttons point.
#
# Deliberately EMPTY: backoffice.animalesko.org is not pointed at the apps/plus
# deployment yet. While it is empty the landing prints the address as plain text
# with an "em breve" badge instead of rendering a dead link, and the provider
# CTAs fall back to the contact form. Set it — to https://backoffice.animalesko.org
# in production, or http://localhost:3001 to work against apps/plus locally —
# and every one of those entry points becomes a real link, with no code change.
NEXT_PUBLIC_BACKOFFICE_URL=""

# Where the "faça parte" form sends a lead (CRM, automation hook, internal
# route). While empty, submissions are only written to the server log — the
# visitor still sees a success message, so do set this before announcing the
# site anywhere.
LANDING_LEADS_WEBHOOK_URL=""

# Search Console verification token, if you verify by meta tag rather than DNS.
GOOGLE_SITE_VERIFICATION=""

# Where apps/mobile sends its requests, baked into the native bundle at build
# time. It has to be absolute: inside a WebView the page's own origin is
# capacitor://localhost (iOS) or http://localhost (Android), never the API host.
#
# On a simulator "localhost" is the simulator itself, so pointing a device build
# at a dev server means this must be the machine's LAN address (e.g.
# http://192.168.1.10:3000) — and that address must also be in
# AUTH_TRUSTED_ORIGINS. In production it is the apps/app deployment.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Seeding and cleanup — see README, "Seeding and cleanup".
#
# `pnpm db:seed` and `pnpm db:cleanup` both TRUNCATE before writing. Against a
# local database they run unguarded; against any other host they refuse unless
# SEED_CONFIRM matches the database name in DIRECT_DATABASE_URL exactly.
# -----------------------------------------------------------------------------
SEED_CONFIRM=""

# Fixes the generated dataset. Two runs with the same value produce identical
# data, so a screenshot can be reproduced from the seed alone.
SEED_RANDOM_SEED="animalesko"

# The one account that survives `pnpm db:cleanup`. Left unset, no administrator
# is created — deliberately, since a default password here would be committed,
# published, and attached to the only ADMIN account on a live database.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""

# -----------------------------------------------------------------------------
# File uploads (Vercel Blob) — optional.
#
# Used by apps/plus for adoption listing photos and provider verification
# documents. Create a Blob store on Vercel and run `vercel env pull` to obtain
# it. Left unset, those two forms fall back to accepting an image URL, so the
# workspace still runs end-to-end on `pnpm setup` alone.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
