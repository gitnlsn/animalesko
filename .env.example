# -----------------------------------------------------------------------------
# Copy to .env and adjust. `pnpm db:up` provisions a Postgres matching these.
# -----------------------------------------------------------------------------

# Postgres provisioned by docker-compose.yml
POSTGRES_USER=animalesko
POSTGRES_PASSWORD=animalesko
POSTGRES_PORT=5433

# Application database
DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_dev?schema=public"

# Unpooled connection, used by `prisma migrate`. Identical locally; on Vercel this
# is the direct (non-pgbouncer) URL while DATABASE_URL points at the pooler.
DIRECT_DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_dev?schema=public"

# Database used by the integration suite. Wiped and re-migrated on every run —
# never point this at anything you care about.
TEST_DATABASE_URL="postgresql://animalesko:animalesko@localhost:5433/animalesko_test?schema=public"

# -----------------------------------------------------------------------------
# Auth (Better Auth). Generate a secret with: openssl rand -base64 32
# -----------------------------------------------------------------------------
BETTER_AUTH_SECRET="dev-only-secret-change-me-before-deploying"
BETTER_AUTH_URL="http://localhost:3000"

# Cookies are shared across both apps in production so a single session works on
# app.animalesko.com and plus.animalesko.com. Leave empty for localhost.
AUTH_COOKIE_DOMAIN=""

# -----------------------------------------------------------------------------
# Public URLs — apps/app runs on 3000, apps/plus on 3001
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PLUS_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# File uploads (Vercel Blob) — optional.
#
# Used by apps/plus for adoption listing photos and provider verification
# documents. Create a Blob store on Vercel and run `vercel env pull` to obtain
# it. Left unset, those two forms fall back to accepting an image URL, so the
# workspace still runs end-to-end on `pnpm setup` alone.
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""
