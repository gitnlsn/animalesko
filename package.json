{
  "name": "animalesko",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\" --ignore-path .gitignore",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @animalesko/api test:integration",
    "check:routes": "node scripts/check-route-parity.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:nuke": "docker compose down -v",
    "db:migrate": "pnpm --filter @animalesko/db migrate:dev",
    "db:deploy": "pnpm --filter @animalesko/db migrate:deploy",
    "db:generate": "pnpm --filter @animalesko/db generate",
    "db:seed": "pnpm --filter @animalesko/db seed",
    "db:seed:reference": "pnpm --filter @animalesko/db seed:reference",
    "db:cleanup": "pnpm --filter @animalesko/db cleanup",
    "db:studio": "pnpm --filter @animalesko/db studio",
    "db:reset": "pnpm --filter @animalesko/db reset",
    "setup": "pnpm install && pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@animalesko/config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.10",
    "typescript": "catalog:"
  }
}
