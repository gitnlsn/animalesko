{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL",
    "VERCEL_PROJECT_PRODUCTION_URL",
    "DATABASE_URL",
    "DIRECT_DATABASE_URL",
    "TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "AUTH_TRUSTED_ORIGINS",
    "AUTH_COOKIE_DOMAIN",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_PLUS_URL",
    "NEXT_PUBLIC_API_URL",
    // apps/landing. NEXT_PUBLIC_SITE_URL drives every canonical URL and the
    // sitemap; NEXT_PUBLIC_BACKOFFICE_URL is empty until DNS points
    // backoffice.animalesko.org at the apps/plus deployment.
    "NEXT_PUBLIC_SITE_URL",
    "NEXT_PUBLIC_BACKOFFICE_URL",
    "NEXT_PUBLIC_FORCE_INDEXABLE",
    "GOOGLE_SITE_VERIFICATION",
    "LANDING_LEADS_WEBHOOK_URL",
    "BLOB_READ_WRITE_TOKEN",
    // Firebase service-account JSON for push delivery. Absent on a fresh clone
    // and in CI, where sendPush is a deliberate no-op.
    "FCM_SERVICE_ACCOUNT",
    // Read by apps/mobile/capacitor.config.ts at `cap sync` time. Opens
    // mixed-content for a local http dev server; never set for a release.
    "CAP_DEV",
    // Gates push registration in apps/mobile. Off by default: calling
    // register() without Firebase credentials crashes the app natively.
    "NEXT_PUBLIC_PUSH_ENABLED",
    // Read only by prisma/seed.ts and prisma/cleanup.ts, which Turborepo does
    // not run — declared here so the lint rule can see them.
    "SEED_CONFIRM",
    "SEED_RANDOM_SEED",
    "ADMIN_EMAIL",
    "ADMIN_PASSWORD",
    "ADMIN_NAME"
  ],
  "globalDependencies": ["**/.env.*local", "pnpm-workspace.yaml"],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/schema/**/*.prisma"],
      "outputs": ["src/generated/**"]
    },
    "@animalesko/db#build": {
      // The db package "builds" by generating the Prisma client, so its cached
      // artefact is the generated source, not a .next or dist directory.
      "inputs": ["prisma/schema/**/*.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DIRECT_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_PLUS_URL",
        // Baked into the native bundle at build time: it is the absolute URL of
        // the apps/app deployment, and a cached build from a different value
        // would ship an app pointing at the wrong API.
        "NEXT_PUBLIC_API_URL",
        // Baked into apps/landing's HTML: canonical tags, sitemap entries and
        // the visible back-office CTA. A cached build from a different value
        // would publish canonicals pointing at the wrong host.
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_BACKOFFICE_URL",
        "NEXT_PUBLIC_FORCE_INDEXABLE",
        "GOOGLE_SITE_VERIFICATION",
        "VERCEL_ENV",
        "VERCEL_PROJECT_PRODUCTION_URL"
      ],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^generate"]
    },
    "lint": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      // `@animalesko/db#generate` is named explicitly, not just reached through
      // `^generate`. apps/mobile does not depend on the db package — nothing in
      // a native bundle may import Prisma — but its tsconfig still traverses
      // into packages/api, which does. Without the explicit edge Turborepo is
      // free to typecheck mobile while `generate` is rewriting
      // src/generated/**, and the failure reads as a hundred missing Prisma
      // types rather than as a race.
      "dependsOn": ["^build", "^generate", "@animalesko/db#generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "cache": false,
      "dependsOn": ["^generate"],
      "env": ["DATABASE_URL", "TEST_DATABASE_URL"]
    },
    "clean": {
      "cache": false
    }
  }
}
