packages/db/src/generated/
coverage/

# Written by Next itself, and written *differently* by each command: `next dev`
# points it at .next/dev/types, `next build` at .next/types. Tracked, it flips
# back and forth and shows up dirty after whichever ran last. It carries a
# "should not be edited" notice, every command regenerates it, and typecheck
# passes without it on a fresh clone — so it is not tracked.
next-env.d.ts

# env
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
pnpm-debug.log*

# The two Lovable prototypes. Kept locally as reference while the port is in
# progress; each carries its own .git, so committing them would record broken
# gitlinks rather than files.
old/

# Android release signing. The upload key proves a build came from us; Play
# cannot rotate it without support intervention, so it never enters the repo.
apps/mobile/android/keystore.properties
*.jks
*.keystore


